;; Curated realistic HTML pages, hand-written inputs for the
;; html-xml campaign golden generation (design D11). These are INPUTS
;; only, authored for realism (nav lists, tables, script/style blocks,
;; entity-dense text, mixed quoting, depth-varied nesting, svg-flavored
;; self-closing tags, tolerance-tier mess). Every expected value is
;; generated through the python3 oracle:
;;   python3 tools/gen_html_oracle.py -o tests/fixtures/html/golden.edn \
;;       tests/fixtures/html/html5lib_tokenizer_inputs.edn \
;;       tests/fixtures/html/curated_pages.edn
[
 {:id "curated-landing" :description "Realistic landing page: doctype, head with style and script, nav list, mixed attribute quoting, entities, void elements, comment" :input "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Mino &amp; Friends &#8212; tools for scripts</title>\n  <link rel='stylesheet' href='/assets/main.css' media=screen>\n  <style>\n    body { font-family: sans-serif; color: #222; }\n    .hero > h1 { margin: 0 auto; }\n  </style>\n  <script src=\"/assets/app.js\" defer></script>\n</head>\n<body class='landing' data-theme>\n  <!-- global header -->\n  <header>\n    <nav aria-label='Main'>\n      <ul>\n        <li><a href=\"/\">Home</a></li>\n        <li><a href=\"/docs\" title='Docs &amp; guides'>Docs</a></li>\n        <li><a href='/download'>Download</a></li>\n      </ul>\n    </nav>\n  </header>\n  <div class=\"hero\">\n    <h1>Build tiny tools &mdash; fast</h1>\n    <p>One binary, zero deps&hellip; really. Prices from &euro;0. &#169; 2026</p>\n    <img src=\"/hero.png\" alt=\"Hero shot\" width=640 height='480'>\n  </div>\n  <footer><p>Contact &lt;info@example.com&gt;</p></footer>\n</body>\n</html>"}
 {:id "curated-article" :description "Entity-dense article text with numeric and named references, blockquote, figure, comments" :input "<!DOCTYPE html>\n<html><head><title>Field notes</title></head><body>\n<article>\n  <h2>Notes &amp; observations</h2>\n  <p>The caf&eacute; on Rue &amp; Co&#116;&eacute; serves tea for 4&#8364; a pot &mdash; cheap&comma; no?</p>\n  <p>Measurements: 6&#160;mm &plusmn; 0&#46;5&hellip; see table&nbsp;below &#x1F600;</p>\n  <blockquote cite=\"/sources/1\">\n    <p>&quot;All models are wrong&semi; some are useful.&quot; &mdash; old saw</p>\n  </blockquote>\n  <!-- figure below has no caption -->\n  <figure>\n    <img src=\"chart.png\" alt=\"Chart of &amp; vs &lt;\">\n    <figcaption>Yield &percnt; over time</figcaption>\n  </figure>\n  <p>Copyright &copy; 2006&#8211;2026 The Authors. &yuml; values &GT; zero.</p>\n</article>\n</body></html>"}
 {:id "curated-table" :description "Data table with caption, colgroup, thead/tbody, whitespace text directly inside table, scope and mixed quoting" :input "<!DOCTYPE html>\n<table class=\"data stats\" id='q3'>\n  <caption>Q3 results (all figures in &euro;1k)</caption>\n  <colgroup><col span=2><col class='total'></colgroup>\n  <thead>\n    <tr><th scope=col>Region</th><th scope=\"col\">Units</th><th scope='col'>Total</th></tr>\n  </thead>\n  <tbody>\n    stray row text kept as a direct child\n    <tr><td>Nordics</td><td>1&thinsp;204</td><td>98,5</td></tr>\n    <tr><td>DACH &amp; al.</td><td>2&nbsp;017</td><td>190</td></tr>\n  </tbody>\n</table>"}
 {:id "curated-svg" :description "Inline SVG flavored page with self-closing rect/path/use and nested groups (solidus realism)" :input "<html><body>\n<svg viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" width='10em'>\n  <defs>\n    <linearGradient id=\"g\"><stop offset=\"0%\" stop-color=\"#fee\"/><stop offset=\"100%\" stop-color=\"#eef\"/></linearGradient>\n  </defs>\n  <g fill=\"url(#g)\" stroke='#333' stroke-width=0.5>\n    <rect x=\"5\" y=\"5\" width=\"90\" height=\"90\" rx=\"8\"/>\n    <path d=\"M10 50 Q 30 10 50 50 T 90 50\" fill=\"none\"/>\n    <circle cx=50 cy=50 r=30/>\n    <use href=\"#g\"/>\n    <text x=\"50\" y=\"90\" text-anchor=\"middle\">&amp; fwd</text>\n  </g>\n</svg>\n<math><mi>x</mi><mo>&lt;</mo><mn>2</mn></math>\n</body></html>"}
 {:id "curated-form" :description "Form surface: fieldset legend, label, inputs with valueless attrs, select options, textarea with markup-ish text" :input "<form action=\"/search\" method=get class=\"search\">\n  <fieldset disabled>\n    <legend>Refine &amp; filter</legend>\n    <label for=q>Query</label>\n    <input id=q name=q type=search placeholder=\"cats &amp; dogs\" required maxlength=80>\n    <input type=\"hidden\" name=\"lang\" value=\"en\">\n    <select name=sort>\n      <option value=relevance selected>Relevance</option>\n      <option value='date'>Date</option>\n    </select>\n    <textarea name=\"notes\" rows=4 cols=30>Type <b>notes</b> &amp; more here&hellip;</textarea>\n    <button type=submit>Go</button>\n  </fieldset>\n</form>"}
 {:id "curated-messy" :description "Realistic sloppy page: unclosed li and p, misnested inline, stray end tag, uppercase names, implied closes" :input "<HTML>\n<BODY>\n<P>Welcome\n<UL>\n  <LI>one\n  <LI>two\n  <LI>three\n</UL>\n<P>Paragraph with <B>bold <I>both</B> italic</I> tail\n<DIV class=Outer><SPAN>a</SPAN><SPAN>b\n<P>after unclosed spans\n</STRAY>\n<div><div><div><p>deep enough</div></div></div>\n</BODY>\n</HTML>"}
 {:id "curated-rcdata" :description "RCDATA and RAWTEXT realism: title with markup text, textarea with refs and tags-as-text, script holding div literals and entity" :input "<html>\n<head><title>Settings &amp; the <b>bold</b> question</title></head>\n<body>\n<textarea name=raw rows=3>Value &amp; &lt;tag&gt; &copy; stays text</textarea>\n<script type=\"text/javascript\">\n  var s = \"</div> is fine here &amp; so is <b>\";\n  if (a < b && c > d) { render(\"<p class='x'>\" + s + \"</p>\"); }\n</script>\n<style>p::before { content: \"&amp;\"; }</style>\n</body>\n</html>"}
 {:id "curated-meta" :description "Comment and declaration variants: bogus comments, CDATA in html content, duplicate and later doctype" :input "<!DOCTYPE html>\n<!-- a normal comment with -- dashes and <tags> inside -->\n<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<!foo bar>\n<html><body>\n<![CDATA[not really cdata in html]]>\n<p>text after odd declarations</p>\n<!-- trailing comment -->\n</body></html>\n<!DOCTYPE html>"}
]
